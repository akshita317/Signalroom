# Server
PORT=8787
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://127.0.0.1:5173

# Optional: omit this to use the safe deterministic demo provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional GitHub connector settings for a future live deploy adapter
GITHUB_TOKEN=
GITHUB_REPO=owner/repository

# Optional Freshdesk connector settings. Omit both to use fictional mock tickets.
FRESHDESK_DOMAIN=your-subdomain.freshdesk.com
FRESHDESK_API_KEY=
# Mask emails/phone numbers in agent-facing tool output (default true)
FRESHDESK_REDACT_PII=true
